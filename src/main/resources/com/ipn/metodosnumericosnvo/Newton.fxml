<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns:fx="http://javafx.com/javafx"
            xmlns="http://javafx.com/javafx"
            fx:controller="com.ipn.metodosnumericosnvo.controller.NewtonController"
            prefWidth="1200" prefHeight="1000">
    <top>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <!-- Gráfica en la esquina superior izquierda (cuadrada) -->
            <VBox spacing="5" alignment="TOP_CENTER" minWidth="400" maxWidth="400" minHeight="400" maxHeight="400">
                <padding>
                    <Insets top="5" right="5" bottom="5" left="5"/>
                </padding>
                <Label text="Gráfica de la función" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                <WebView fx:id="geogebraView" minWidth="380" maxWidth="380" minHeight="350" maxHeight="350"/>
                <Label fx:id="geogebraStatusLabel" text="Cargando GeoGebra..." style="-fx-font-size: 10px;"/>
            </VBox>

            <!-- Opciones de entrada en el lado derecho -->
            <VBox spacing="15" alignment="TOP_LEFT" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="20"/>
                </padding>
                <Label text="Método de Newton-Raphson" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

                <GridPane hgap="10" vgap="10">
                    <Label text="Función f(x):" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="fxField" prefWidth="250" promptText="Ej: 3*x-cos(x)-1" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Derivada f'(x) (opcional):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="gxField" prefWidth="250" promptText="Se calculará automáticamente" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="x₀:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="x0Field" prefWidth="100" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Tolerancia:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="tolField" prefWidth="100" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Iter máx:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="maxItField" prefWidth="100" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                </GridPane>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Calcular" onAction="#onCalcular" prefWidth="100"/>
                    <Button fx:id="animarBtn" text="Animar" onAction="#onAnimar" prefWidth="100"/>
                </HBox>
            </VBox>
        </HBox>
    </top>

    <center>
        <!-- Tabla de iteraciones debajo de ambos elementos -->
        <VBox spacing="5">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Tabla de Iteraciones" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <TableView fx:id="tablaPasos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn text="Paso" fx:id="colPaso"/>
                    <TableColumn text="x₀" fx:id="colX0"/>
                    <TableColumn text="f(x₀)" fx:id="colFx0"/>
                    <TableColumn text="x₁" fx:id="colX1"/>
                    <TableColumn text="f(x₁)" fx:id="colFx1"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Raíz encontrada:"/>
            <Label fx:id="resultadoLabel" style="-fx-font-weight: bold;"/>
        </HBox>
    </bottom>
</BorderPane>

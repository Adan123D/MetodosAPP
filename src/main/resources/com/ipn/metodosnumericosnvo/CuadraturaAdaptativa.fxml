<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ipn.metodosnumericosnvo.integracion_controller.CuadraturaAdaptativaController"
            prefWidth="1100.0" prefHeight="700.0">

    <!-- Menú superior (puedes insertar el tuyo si ya tienes uno genérico) -->
    <top>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <MenuBar HBox.hgrow="ALWAYS" prefHeight="25.0">
                <Menu text="Inicio">
                    <MenuItem text="Home" onAction="#onHomeButtonClick"/>
                    <MenuItem text="Salir" onAction="#onExitButtonClick"/>
                </Menu>
            </MenuBar>
        </HBox>
    </top>

    <center>
        <Pane prefHeight="650.0" prefWidth="1100.0">
            <children>
                <Label layoutX="350" layoutY="10" text="CUADRATURA ADAPTATIVA - SIMPSON">
                    <font><Font size="30.0"/></font>
                </Label>

                <!-- Campos de entrada -->
                <Label layoutX="60.0" layoutY="70.0" text="Función:"/>
                <TextField fx:id="txtFuncion" layoutX="150.0" layoutY="65.0" prefWidth="250"/>

                <Label layoutX="60.0" layoutY="110.0" text="Límite a:"/>
                <TextField fx:id="txtA" layoutX="150.0" layoutY="105.0" prefWidth="100"/>

                <Label layoutX="60.0" layoutY="150.0" text="Límite b:"/>
                <TextField fx:id="txtB" layoutX="150.0" layoutY="145.0" prefWidth="100"/>

                <Label layoutX="60.0" layoutY="190.0" text="Tolerancia:"/>
                <TextField fx:id="txtTol" layoutX="150.0" layoutY="185.0" prefWidth="100"/>

                <Label layoutX="60.0" layoutY="230.0" text="Máx. Recursión:"/>
                <TextField fx:id="txtMaxRec" layoutX="150.0" layoutY="225.0" prefWidth="100"/>

                <Button layoutX="300.0" layoutY="260.0" text="Calcular" onAction="#onCalcular"/>

                <Label fx:id="lblResultado" layoutX="420.0" layoutY="265.0" text="Resultado:"/>

                <!-- Tabla de resultados -->
                <TableView fx:id="tablaIteraciones" layoutX="60.0" layoutY="320.0" prefHeight="320.0" prefWidth="980.0">
                    <columns>
                        <TableColumn fx:id="colNivel" text="Nivel"/>
                        <TableColumn fx:id="colA" text="a"/>
                        <TableColumn fx:id="colB" text="b"/>
                        <TableColumn fx:id="colS" text="S"/>
                        <TableColumn fx:id="colS2" text="S2"/>
                        <TableColumn fx:id="colError" text="Error"/>
                    </columns>
                </TableView>
            </children>
        </Pane>
    </center>
</BorderPane>
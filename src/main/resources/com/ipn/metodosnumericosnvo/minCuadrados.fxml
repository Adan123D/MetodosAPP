<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="8" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ipn.metodosnumericosnvo.diferenciales_controller.minCuadradosController" alignment="CENTER">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>
    <Label text="Mínimos Cuadrados Polinomial" style="-fx-font-size:16px;"/>
    <HBox spacing="6">
        <Label text="Grado del polinomio:"/>
        <TextField fx:id="gradoField" prefWidth="60"/>
        <Label text="X:"/>
        <TextField fx:id="xField" prefWidth="150" promptText="Ej: 1,2,3"/>
        <Label text="Y:"/>
        <TextField fx:id="yField" prefWidth="150" promptText="Ej: 2.1,3.4,4.9"/>
        <Button fx:id="calcularBtn" text="Calcular" onAction="#onCalcular"/>
    </HBox>
    <TableView fx:id="tablaCoeficientes" prefHeight="220" prefWidth="700">
        <columns>
            <TableColumn text="Coeficientes" fx:id="colCoeficientes"/>
        </columns>
    </TableView>
    <Label fx:id="resultLabel" style="-fx-font-size:14px;"/>
    <Button fx:id="resolverSistemaBtn" text="Resolver Sistema con Eliminación Gaussiana" onAction="#onResolverSistema"/>
</VBox>

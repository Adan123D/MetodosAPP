<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ipn.metodosnumericosnvo.controller.MullerController" alignment="CENTER"
      fx:id="rootPane">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>
    <Label text="Método de Müller (Soporta números complejos)" style="-fx-font-size: 16px; -fx-text-fill: white;"/>
    <HBox spacing="10">
        <Label text="f(x):" style="-fx-text-fill: white;"/>
        <TextField fx:id="fxField" promptText="Ej: x^3-x-1" prefWidth="120"/>
        <Label text="x₁:" style="-fx-text-fill: white;"/>
        <TextField fx:id="x1Field" promptText="Ej: 1 o 1+2i" prefWidth="70"/>
        <Label text="x₂:" style="-fx-text-fill: white;"/>
        <TextField fx:id="x2Field" promptText="Ej: 2 o 2-3i" prefWidth="70"/>
        <Label text="x₃:" style="-fx-text-fill: white;"/>
        <TextField fx:id="x3Field" promptText="Ej: 3 o 0+1i" prefWidth="70"/>
        <Label text="Error:" style="-fx-text-fill: white;"/>
        <TextField fx:id="tolField" prefWidth="60"/>
        <Label text="Iter máx:" style="-fx-text-fill: white;"/>
        <TextField fx:id="maxItField" prefWidth="60"/>
        <Button text="Calcular" onAction="#onCalcular"/>
    </HBox>
    <TableView fx:id="tablaPasos" prefHeight="250" prefWidth="950" style="-fx-base: rgba(60, 60, 60, 0.8); -fx-control-inner-background: rgba(60, 60, 60, 0.8); -fx-background-color: rgba(60, 60, 60, 0.8); -fx-table-cell-border-color: derive(-fx-control-inner-background, -10%); -fx-table-header-border-color: derive(-fx-control-inner-background, -20%);">
        <columns>
            <TableColumn text="Paso" fx:id="colPaso" style="-fx-text-fill: white;"/>
            <TableColumn text="x₁" fx:id="colX1" style="-fx-text-fill: white;"/>
            <TableColumn text="x₂" fx:id="colX2" style="-fx-text-fill: white;"/>
            <TableColumn text="x₃" fx:id="colX3" style="-fx-text-fill: white;"/>
            <TableColumn text="f(x₁)" fx:id="colFx1" style="-fx-text-fill: white;"/>
            <TableColumn text="f(x₂)" fx:id="colFx2" style="-fx-text-fill: white;"/>
            <TableColumn text="f(x₃)" fx:id="colFx3" style="-fx-text-fill: white;"/>
            <TableColumn text="a" fx:id="colA" style="-fx-text-fill: white;"/>
            <TableColumn text="b" fx:id="colB" style="-fx-text-fill: white;"/>
            <TableColumn text="c" fx:id="colC" style="-fx-text-fill: white;"/>
            <TableColumn text="x₄" fx:id="colX4" style="-fx-text-fill: white;"/>
            <TableColumn text="f(x₄)" fx:id="colFx4" style="-fx-text-fill: white;"/>
        </columns>
        <style>
            -fx-text-fill: white;
            .table-row-cell { -fx-text-fill: white; }
            .table-column { -fx-text-fill: white; }
            .table-cell { -fx-text-fill: white; }
            .column-header { -fx-text-fill: white; -fx-font-weight: bold; }
            .column-header-background { -fx-background-color: rgba(60, 60, 60, 0.8); }
        </style>
    </TableView>
    <Label fx:id="resultadoLabel" style="-fx-font-size: 16px; -fx-text-fill: white;"/>
</VBox>

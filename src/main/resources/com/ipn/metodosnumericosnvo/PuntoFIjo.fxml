<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns:fx="http://javafx.com/javafx"
            xmlns="http://javafx.com/javafx"
            fx:controller="com.ipn.metodosnumericosnvo.controller.PuntoFIjoController"
            prefWidth="1200" prefHeight="1000">
    <top>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <!-- Gráfica en la esquina superior izquierda (cuadrada) -->
            <VBox spacing="5" alignment="TOP_CENTER" minWidth="400" maxWidth="400" minHeight="400" maxHeight="400">
                <padding>
                    <Insets top="5" right="5" bottom="5" left="5"/>
                </padding>
                <Label text="Gráfica de la función" style="-fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
                <WebView fx:id="geogebraView" minWidth="380" maxWidth="380" minHeight="350" maxHeight="350"/>
                <Label fx:id="geogebraStatusLabel" text="Cargando GeoGebra..." style="-fx-font-size: 10px;"/>
            </VBox>

            <!-- Opciones de entrada en el lado derecho -->
            <VBox spacing="15" alignment="TOP_LEFT" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="20"/>
                </padding>
                <Label text="Método del Punto Fijo" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

                <GridPane hgap="10" vgap="10">
                    <Label text="g(x):" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="gTxt" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="x₀:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="x0Txt" prefWidth="100" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Iteraciones máximas:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="maxIterTxt" prefWidth="100" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Tolerancia ε:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="tolTxt" prefWidth="100" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Calcular" onAction="#onCalcular" prefWidth="100"/>
                    <Button fx:id="animarBtn" text="Animar" onAction="#onAnimar" prefWidth="100"/>
                </HBox>
            </VBox>
        </HBox>
    </top>

    <center>
        <!-- Tabla de iteraciones debajo de ambos elementos -->
        <VBox spacing="5">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Tabla de Iteraciones" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn text="i" fx:id="colIter"/>
                    <TableColumn text="xᵢ" fx:id="colXi"/>
                    <TableColumn text="g(xᵢ)" fx:id="colGxi"/>
                    <TableColumn text="Error" fx:id="colError"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Raíz encontrada:"/>
            <Label fx:id="resultLbl" style="-fx-font-weight: bold;"/>
        </HBox>
    </bottom>
</BorderPane>

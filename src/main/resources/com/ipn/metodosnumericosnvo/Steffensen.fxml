<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns:fx="http://javafx.com/javafx"
            xmlns="http://javafx.com/javafx"
            fx:controller="com.ipn.metodosnumericosnvo.controller.SteffensenController"
            fx:id="rootPane"
            prefWidth="1200" prefHeight="1000">
    <top>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <!-- Gráfica en la esquina superior izquierda (cuadrada) -->
            <VBox spacing="5" alignment="TOP_CENTER" minWidth="400" maxWidth="400" minHeight="400" maxHeight="400">
                <padding>
                    <Insets top="5" right="5" bottom="5" left="5"/>
                </padding>
                <Label text="Gráfica de la función" style="-fx-font-weight: bold; -fx-text-fill: white;" alignment="CENTER" maxWidth="Infinity"/>
                <WebView fx:id="geogebraView" minWidth="380" maxWidth="380" minHeight="350" maxHeight="350"/>
                <Label fx:id="geogebraStatusLabel" text="Cargando GeoGebra..." style="-fx-font-size: 10px; -fx-text-fill: white;"/>
            </VBox>

            <!-- Opciones de entrada en el lado derecho -->
            <VBox spacing="15" alignment="TOP_LEFT" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="20"/>
                </padding>
                <Label text="Método de Steffensen" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: white;"/>

                <GridPane hgap="10" vgap="10">
                    <Label text="Función f(x):" style="-fx-text-fill: white;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="fxField" prefWidth="250" promptText="Ej: x^3-x-1" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="x₀:" style="-fx-text-fill: white;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="x0Field" prefWidth="100" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Tolerancia:" style="-fx-text-fill: white;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="tolField" prefWidth="100" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Iter máx:" style="-fx-text-fill: white;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="maxItField" prefWidth="100" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                </GridPane>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Calcular" onAction="#onCalcular" prefWidth="100"/>
                    <Button fx:id="animarBtn" text="Animar" onAction="#onAnimar" prefWidth="100"/>
                </HBox>
            </VBox>
        </HBox>
    </top>

    <center>
        <!-- Tabla de iteraciones debajo de ambos elementos -->
        <VBox spacing="5">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Tabla de Iteraciones" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: white;"/>
            <TableView fx:id="table" VBox.vgrow="ALWAYS" style="-fx-base: rgba(60, 60, 60, 0.8); -fx-control-inner-background: rgba(60, 60, 60, 0.8); -fx-background-color: rgba(60, 60, 60, 0.8); -fx-table-cell-border-color: derive(-fx-control-inner-background, -10%); -fx-table-header-border-color: derive(-fx-control-inner-background, -20%);">
                <columns>
                    <TableColumn text="Paso" fx:id="colPaso" style="-fx-text-fill: white;"/>
                    <TableColumn text="xₙ" fx:id="colXn" style="-fx-text-fill: white;"/>
                    <TableColumn text="f(xₙ)" fx:id="colFxn" style="-fx-text-fill: white;"/>
                    <TableColumn text="f(xₙ+f(xₙ))" fx:id="colFxnPlus" style="-fx-text-fill: white;"/>
                    <TableColumn text="xₙ₊₁" fx:id="colXn1" style="-fx-text-fill: white;"/>
                    <TableColumn text="f(xₙ₊₁)" fx:id="colFxn1" style="-fx-text-fill: white;"/>
                </columns>
                <style>
                    -fx-text-fill: white;
                    .table-row-cell { -fx-text-fill: white; }
                    .table-column { -fx-text-fill: white; }
                    .table-cell { -fx-text-fill: white; }
                    .column-header { -fx-text-fill: white; -fx-font-weight: bold; }
                    .column-header-background { -fx-background-color: rgba(60, 60, 60, 0.8); }
                </style>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Raíz encontrada:" style="-fx-text-fill: white;"/>
            <Label fx:id="resultLabel" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>
    </bottom>
</BorderPane>
